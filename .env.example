# Pexels API key (obtené una gratis en https://www.pexels.com/api/)
# Se usa SOLO del lado del servidor de desarrollo (proxy de Vite). No se expone al navegador.
PEXELS_API_KEY=tu_key_aqui

# Intervalo de polling (ms) para sincronizar en tiempo real. Default: 5000.
# El frontend deja de consultar cuando la pestaña está oculta (ahorra requests y evita
# despertar el cold start de Render innecesariamente).
VITE_POLL_INTERVAL=5000

# -----------------------------------------------------------------------------
# Ambiente de desarrollo en Render (tercer servicio: kiosko-247-dev)
# Arena aislada para refactors grandes (p.ej. dividir App.jsx) sin tocar
# calidad ni producción. Usa la MISMA Neon pero schema propio "dev", con espejo
# automático public -> dev (igual mecanismo que staging).
# Se configuran en el dashboard de Render en el servicio kiosko-247-dev:
# -----------------------------------------------------------------------------
# KIOSKO_DB_SCHEMA=dev
#   Schema donde la app de dev lee/escribe. En producción es "public"; en staging "staging".
# MIRROR_SOURCE_SCHEMA=public
# MIRROR_TARGET_SCHEMA=dev
#   Refresco de espejo: copia produccion -> schema dev. Nunca public como destino.
# KIOSKO_REFRESH_INTERVAL_MS=3600000
#   Espejo automático cada hora (sin esto, el espejo corre solo con /api/mirror/refresh).
# ADMIN_PASSWORD / ADMIN_PHONES / DATABASE_URL / SUPABASE_*:
#   Mismas variables que los otros servicios, con secretos propios de dev.
#   WARNING: DATABASE_URL debe apuntar a la Neon compartida, pero la app de dev
#   solo opera en schema "dev" (los datos reales llegan vía espejo, no por escritura).
# Para probar un refactor: en Render, cambiale la RAMA del servicio a la rama del PR.
# Apagá el servicio cuando no lo uses: comparte las horas del plan free.
